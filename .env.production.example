# ==============================================================================
# Keto Balance — Production Environment Template (.env.production)
# ==============================================================================

# Публичный домен приложения для HTTPS (например, ketobalans.ru или поддомен)
WEBAPP_DOMAIN=app.example.com

# Токен Telegram-бота от @BotFather (например, 123456789:ABCDefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Секретный токен для вебхуков (произвольная случайная строка)
TELEGRAM_WEBHOOK_SECRET_TOKEN=generate_random_secret_string_here

# Опционально: Прокси для Telegram API в российских дата-центрах при наличии сетевых блокировок
# Поддерживаются протоколы: http://, https://, socks5://
# KETO_BOT_PROXY=http://proxy_user:proxy_password@proxy_host:proxy_port

# Режим платежей (ПО УМОЛЧАНИЮ СТРОГО ОТКЛЮЧЕНЫ)
PAYMENT_MODE=disabled
PAYMENTS_ENABLED=0

# Идентификатор владельца (Ольга) для сервисных уведомлений
OWNER_TELEGRAM_ID=1084557944
