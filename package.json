{
  "name": "keto-balance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "build": "node scripts/validate-catalog.mjs && tsc && vite build && node scripts/export-release-catalog.mjs && node scripts/stamp-release.mjs",
    "preview": "vite preview",
    "test:unit": "node --test --test-reporter=tap tests/frontend/*.test.cjs",
    "typecheck": "tsc --noEmit --incremental false --pretty false",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
