# ========================================================
# Keto Balance — Настройки окружения
# ========================================================

# 1. Токен Telegram-бота (получите у @BotFather в Telegram: команда /newbot)
KETO_BOT_TOKEN=""

# 2. URL приложения Telegram Mini App (Web App)
# Для локальной разработки: http://localhost:5173 или http://localhost:8000
# Для продакшена в Telegram требуется публичный HTTPS (Cloudflare Tunnel, ngrok, Vercel)
WEBAPP_URL="http://localhost:5173"

# 3. Режим оплат:
# demo — тестовый режим с эмуляцией оплаты (без списания денег, для тестирования)
# live — реальный приём платежей через ЮKassa/Robokassa
PAYMENT_MODE="demo"

# 4. Токен платежного провайдера (получите у @BotFather в меню Payments для бота)
PAYMENT_PROVIDER_TOKEN=""

# 5. Каналы, поддержка и личный контакт нутрициолога
# ВНИМАНИЕ: Конфигурации канала, техподдержки и лички нутрициолога строго изолированы!
# Автоматический fallback личных обращений на канал или группу категорически запрещён.

# 5.1. Публичный Telegram-канал (новости, рецепты, база знаний)
# Информационный канал нутрициолога. Личные вопросы сюда НЕ направляются.
CHANNEL_URL="https://t.me/olga_nutri_med"

# 5.2. Чат технической поддержки или комьюнити пользователей
# Чат для технических вопросов по работе бота/приложения и общения пользователей.
# Не использовать для персональных консультаций нутрициолога.
SUPPORT_CHAT="https://t.me/keto_balance_support"

# 5.3. Личный контакт нутрициолога (Ольга) — ОБЯЗАТЕЛЬНОЕ УКАЗАНИЕ
# Telegram username личного аккаунта нутрициолога (без символа @).
# Сюда направляются вопросы пользователей для персональной консультации.
# Категорически запрещено указывать адрес публичного канала (olga_nutri_med)!
NUTRITIONIST_USERNAME="Olgazinchenko1186"

# 5.4. Числовой Telegram chat ID нутрициолога — ОБЯЗАТЕЛЬНОЕ УКАЗАНИЕ
# Числовой ID личного аккаунта Telegram (узнать можно через @userinfobot).
# Используется ботом для прямой доставки текстовых вопросов от пользователей в ЛС нутрициологу.
# Категорически запрещено указывать ID публичных каналов или групп (отрицательные ID)!
NUTRITIONIST_CHAT_ID="1084557944"

# 5.5. ID администратора бота для системных уведомлений
ADMIN_ID="1084557944"
